# ============================================================
# BELIEVE PLATFORM — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local
# ============================================================

# ── Supabase (required) ───────────────────────────────────────
# From: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Service Role (required for API routes) ───────────
# Used server-side only — never expose to browser
# From: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Worker Secret (required for Render worker → Vercel API) ──
# Any long random string. Must match WORKER_SECRET in Render env vars.
# Generate one: openssl rand -hex 32
WORKER_SECRET=your-random-secret-here

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
