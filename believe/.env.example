# ============================================================
# BELIEVE PLATFORM — Environment Variables
# Copy to .env.local — never commit .env.local to git
# ============================================================

# ── Supabase (required) ───────────────────────────────────────
# From: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Worker secret (required for Render→Vercel communication) ──
# Generate: openssl rand -hex 32
WORKER_SECRET=your-random-secret-here

# ── Hugging Face (required for AI Recommendations) ────────────
# Model used: moonshotai/Kimi-K2-Instruct
# Get your key from: https://huggingface.co/settings/tokens
# Create a token with "Inference" permission (Read access is enough)
HF_API_KEY=hf_your_token_here

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
