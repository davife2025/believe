# ============================================================
# BELIEVE WORKER — Environment Variables (Render)
# Set these in: Render Dashboard → Your Service → Environment
# ============================================================

# Your deployed Vercel app URL (no trailing slash)
VERCEL_URL=https://your-believe-app.vercel.app

# Must match WORKER_SECRET in your Vercel environment variables
# Generate: openssl rand -hex 32
WORKER_SECRET=your-random-secret-here

# Hugging Face API key — for Kimi K2 LLM calls in the worker
# Get from: https://huggingface.co/settings/tokens
# Must have "Inference" permission
HF_API_KEY=hf_your_token_here

PORT=3001
NODE_ENV=production
